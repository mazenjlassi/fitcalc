{
  "name": "fitcalc",
  "version": "0.1.0",
  "description": "Free, privacy-first fitness calculators that run in the browser.",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.13.1",
    "npm": ">=11"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
